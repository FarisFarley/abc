[
  {
    "arabic": "دعوتك يا رب والليل داجل"
  },
  {
    "arabic": "وأنت العظيم الذي لا ينام"
  },
  {
    "arabic": "إلهي ضعفت وأنت القوي"
  },
  {
    "arabic": "وحسبي عنك الرضا والسلام"
  },
  {
    "arabic": "إذا ضاقت الأرض يوما عليا"
  },
  {
    "arabic": "فبابك يا ربي نعم المقام"
  },
  {
    "arabic": "أمد يدي إليك افتقارا"
  },
  {
    "arabic": "فبالنور منك يزول الظلام"
  },
  {
    "arabic": "إلهي ولا تكلني لنفسي"
  },
  {
    "arabic": "ليحسن عندك من الختام"
  }
]