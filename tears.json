[
  {
    "start_time": "00:00.1",
    "end_time": "00:02.1",
    "arabic": "يا رب والليل",
    "english": "O Lord, as the night",
    "urdu": "اے رب، جب رات"
  },
  {
    "start_time": "00:02.1",
    "end_time": "00:07.2",
    "arabic": "الطويل مخيم",
    "english": "Stretches long and settles deep",
    "urdu": "لمبی ہو کر چھا جاتی ہے"
  },
  {
    "start_time": "00:07.2",
    "end_time": "00:14.0",
    "arabic": "أدعوك مرتجيًا وأنت مجيب",
    "english": "I call on You with hope, for You alone answer",
    "urdu": "میں امید سے تجھے پکارتا ہوں، اور تو ہی جواب دینے والا ہے"
  },
  {
    "start_time": "00:14.0",
    "end_time": "00:16.6",
    "arabic": "يا عالم الأسرار",
    "english": "O Knower of every secret",
    "urdu": "اے ہر راز کے جاننے والے"
  },
  {
    "start_time": "00:16.6",
    "end_time": "00:20.7",
    "arabic": "قبل بيانها",
    "english": "Before it is ever spoken",
    "urdu": "اس کے ظاہر ہونے سے پہلے"
  },
  {
    "start_time": "00:20.7",
    "end_time": "00:27.1",
    "arabic": "فالدمع عني إن سكت خطيب",
    "english": "When I fall silent, my tears speak on my behalf",
    "urdu": "جب میں خاموش ہو جاؤں، میرے آنسو میری طرف سے بولتے ہیں"
  },
  {
    "start_time": "00:27.1",
    "end_time": "00:30.0",
    "arabic": "ما خاب عبد جاء",
    "english": "Never has a servant failed who came",
    "urdu": "کبھی نامراد نہیں ہوا وہ بندہ جو آیا"
  },
  {
    "start_time": "00:30.0",
    "end_time": "00:34.4",
    "arabic": "بابك سائلا",
    "english": "To Your door, asking of You",
    "urdu": "تیرے در پر مانگتے ہوئے"
  },
  {
    "start_time": "00:34.4",
    "end_time": "00:40.8",
    "arabic": "وله بفضلك يا كريم نصيب",
    "english": "For by Your grace, O Most Generous, he is given his share",
    "urdu": "اور تیرے فضل سے، اے کریم، اسے حصہ ملتا ہے"
  },
  {
    "start_time": "00:40.8",
    "end_time": "00:43.2",
    "arabic": "إن ضاقت الدنيا",
    "english": "When the world feels too narrow",
    "urdu": "جب دنیا تنگ لگے"
  },
  {
    "start_time": "00:43.2",
    "end_time": "00:47.3",
    "arabic": "علي برحبها",
    "english": "Despite all its vastness",
    "urdu": "اپنی ساری وسعت کے باوجود"
  },
  {
    "start_time": "00:47.3",
    "end_time": "00:49.6",
    "arabic": "فبذكرك القلب",
    "english": "It is by Your remembrance that the heart",
    "urdu": "تیرے ذکر سے ہی دل"
  },
  {
    "start_time": "00:49.6",
    "end_time": "00:53.8",
    "arabic": "الجريح يطيب",
    "english": "The wounded heart finds its healing",
    "urdu": "زخمی دل شفا پاتا ہے"
  },
  {
    "start_time": "00:53.8",
    "end_time": "01:01.0",
    "arabic": "لا أبتغي ممن سواك عطية",
    "english": "I seek no gift from anyone besides You",
    "urdu": "میں تیرے سوا کسی اور سے عطا نہیں مانگتا"
  },
  {
    "start_time": "01:01.0",
    "end_time": "01:03.5",
    "arabic": "حسبي رضاك إذا",
    "english": "Your pleasure is enough for me when",
    "urdu": "تیری رضا میرے لیے کافی ہے جب"
  },
  {
    "start_time": "01:03.5",
    "end_time": "01:08.8",
    "arabic": "الجميع يغيب",
    "english": "Everyone else fades away",
    "urdu": "سب لوگ غائب ہو جائیں"
  }
]